{% extends 'AdminBundle:Default:admin.html.twig' %}

{% block content %}
<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card strpied-tabled-with-hover">
                    <div class="card-header ">
                        <h4 class="card-title">{{"admin.listado_servicios"|trans}}</h4>
                        <p class="card-category">{{"admin.revisa_edita_crea_servicios"|trans}}</p>
                        <a href="{{ path ('servicio_new') }}"><button type="button" class="btn btn-warning btn-fill pull-right">{{"admin.nuevo_servicio"|trans}}</button></a>
                        <a href="{{ path ('portada_homepage') }}#case-studies" target="_blank"><button type="button" class="btn btn-info btn-fill pull-left">{{"admin.servicios_user_view"|trans}} <i class="fa fa-external-link"></i></button></a>
                    </div>
                    <div class="card-body table-full-width table-responsive">
                        <table class="table table-hover table-striped">
                            <thead>
                                <th>{{"admin.id"|trans}}</th>
                                <th>{{"admin.honorarios"|trans}}</th>
                                <th>{{"admin.nombre"|trans}}</th>
                                <th>{{"admin.editar"|trans}}</th>
                            </thead>
                            <tbody>
                            	{% for servicio in servicios %}
                            	<tr>
                                    <td>{{servicio.id}}</td>
                                    <td>{{servicio.honorarios}}</td>
                                    <td>{{servicio.title}}</td>
                                    <td><a href="{{ path('servicio_edit', {'id': servicio.id}) }}">{{"admin.editar"|trans}} <i class="fa fa-edit"></i></a></td>
                                </tr>
                            	{% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagerfanta -->
                {% if pager is not null and pager.haveToPaginate %}
                    <ul class="pagination justify-content-center">
                        {{ pagerfanta(pager, 'twitter_bootstrap4', {
                            'proximity': 2,
                            'routeName': 'admin_servicios_paginated',
                            'routeParams': app.request.query.all,
                            'prev_message': '<i class="fa fa-angle-left"></i>',
                            'next_message': '<i class="fa fa-angle-right"></i>'
                        }) }}
                    </ul>
                {% endif %}
                <!-- /Pagerfanta -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block script %}
<script type="text/javascript">
    $('.servicios').addClass('nav-item active');
    $('.navbar-brand').text('{{"admin.servicios"|trans}}');
</script>
{% endblock %}